{
    admin off
    persist_config off
    auto_https off
    storage file_system {
        root "@@ROOT@@/caddy-storage"
    }
}
https://@@HOST@@:@@PORT@@ {
    bind 127.0.0.1 ::1
    tls "@@CERT@@" "@@KEY@@"
    @editarr path @@MATCH@@
    handle @editarr {
        # handle preserves the URI; do not replace with handle_path.
        reverse_proxy 127.0.0.1:@@UPSTREAM@@ {
            header_up -Forwarded
            header_up -X-Real-IP
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Port
            header_up -X-Forwarded-Prefix
            header_up X-Forwarded-For {http.request.remote.host}
            header_up X-Forwarded-Proto {http.request.scheme}
        }
    }
    handle {
        respond 404
    }
}
